# Copy to .env.local at the repo root (same location as the old Next.js app).
# Local `dotnet run` loads this file automatically — see Configuration/DotEnvLoader.cs.
# In Azure, set the same names as App Service application settings instead.

# --- SendGrid (waitlist emails + daily activity report) ---
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ADMIN_EMAIL=admin@example.com
FROM_EMAIL=noreply@example.com
# FROM_NAME=Pavillon 46

# --- ACI lead webhook ---
# LEADS_WEBHOOK_URL=https://aci-api-we-rwet2c.azurewebsites.net/api/webhook/leads
# LEADS_WEBHOOK_API_KEY=aci_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Twilio (SMS verification) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Internal activity report (Azure Table Storage) ---
ACTIVITY_LOG_ENABLED=true
ACTIVITY_REPORT_KEY=replace-with-a-long-random-secret
ACTIVITY_IP_SALT=replace-with-a-second-random-secret
ACTIVITY_DAILY_REPORT_TO=pierre.boissart@pavillon46.ch
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# AZURE_STORAGE_TABLE_NAME=ActivityEvents
# ACTIVITY_REPORT_FILE_PATH=

# --- Public site URL (used in email logo links + member login links) ---
SITE_URL=https://pavillon46.ch

# --- Member area (login + admin member management + referrals) ---
# HMAC secret used to sign member session tokens. MUST be set to a long random
# value in production — the built-in default is for local dev only.
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
# Token lifetime in hours (default 72).
# AUTH_TOKEN_TTL_HOURS=72
# Admin key for /api/admin/* (member + applicant management). If left unset it
# falls back to ACTIVITY_REPORT_KEY so there is a single admin secret.
# AUTH_ADMIN_KEY=
# Bonus points granted to a referrer when their referral is accepted (default 100).
# REFERRAL_BONUS_POINTS=100
# Optional: override Azure Table names for members / applicants.
# AZURE_STORAGE_MEMBERS_TABLE=Members
# AZURE_STORAGE_APPLICANTS_TABLE=Applicants

# --- GitHub Actions secrets (production deploy — set in repo Settings → Secrets) ---
# AZURE_STATIC_WEB_APPS_API_TOKEN   SWA deployment token (Azure Portal → Manage deployment token)
# API_BASE_URL                      https://pavillon46-api.azurewebsites.net
# AZURE_WEBAPP_NAME                 pavillon46-api
# AZURE_WEBAPP_PUBLISH_PROFILE      App Service publish profile XML
# ACTIVITY_REPORT_KEY               same value as ACTIVITY_REPORT_KEY above
