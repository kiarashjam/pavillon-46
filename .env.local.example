# Copy this file to .env.local and fill in your values.
# Required for /api/send-email (waitlist form).

# SendGrid API key (create at https://app.sendgrid.com/settings/api_keys)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin email — receives waitlist sign-up notifications
ADMIN_EMAIL=admin@example.com

# Sender address — must be verified in SendGrid (Settings → Sender Authentication)
FROM_EMAIL=noreply@example.com

# Optional: override the waitlist lead webhook URL (defaults to the ACI organizations/leads endpoint)
# LEADS_WEBHOOK_URL=https://example.com/api/leads

# Twilio — required for phone verification SMS
# Get these from https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Create a Verify Service at https://console.twilio.com/us1/develop/verify/services
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Internal activity report (Azure Table Storage)
# Set to false to disable logging entirely
ACTIVITY_LOG_ENABLED=true
NEXT_PUBLIC_ACTIVITY_LOG_ENABLED=true
# Private key used to access /admin/activity and /api/activity/report
ACTIVITY_REPORT_KEY=replace-with-a-long-random-secret
# Salt used to hash visitor IP addresses before storage
ACTIVITY_IP_SALT=replace-with-a-second-random-secret
# End-of-day recipient for daily activity summary
ACTIVITY_DAILY_REPORT_TO=pierre.boissart@pavillon46.ch
# Azure Storage account connection string
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# Optional custom table name (defaults to ActivityEvents)
AZURE_STORAGE_TABLE_NAME=ActivityEvents
